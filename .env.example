# =============================================================================
#  Plantilla de configuracion. Copiar a ".env" y completar.
#  El .env NUNCA va a Git: contiene contrasenas reales.
#      cp .env.example .env
# =============================================================================

# Dominio publico del servidor. Con un dominio real, Caddy pide el certificado
# HTTPS a Let's Encrypt solo. Con "localhost" o una IP, sirve por HTTP y la
# contrasena del operador viaja sin cifrar: solo aceptable de forma transitoria.
DOMINIO=localhost

# Base de datos. La usan el backend y el contenedor de Postgres.
DB_PASSWORD=cambiar-por-una-clave-fuerte

# UID y GID del usuario dueño de la carpeta arca/ en el servidor. El contenedor
# del backend corre con estos valores para poder leer los certificados sin que
# haya que aflojarles los permisos. Obtenerlos con:  id -u   e   id -g
APP_UID=1000
APP_GID=1000

# Unico operador del sistema. El backend lo crea al arrancar.
OPERADOR_EMAIL=admin@bridge.local
OPERADOR_PASSWORD=cambiar-por-una-clave-fuerte

# La cookie de sesion solo viaja por HTTPS. DEJAR EN true.
#
# Se baja a false unicamente mientras el sistema se sirve por IP y todavia no
# hay dominio ni certificado: con secure=true el navegador descarta la cookie
# en HTTP y el login "entra y vuelve a salir".
#
# En false la sesion y la contrasena viajan sin cifrar. Apenas el HTTPS este
# andando, volver a true y reiniciar. El backend avisa por log mientras siga
# en false.
COOKIE_SEGURA=true


# =============================================================================
#  ARCA
#
#  Estas CUATRO variables se mueven JUNTAS. Cambiar una sola y olvidar el resto
#  es el error que mas caro sale, asi que hay validaciones que lo impiden:
#
#   - Si el ambiente no coincide con las URLs, la aplicacion no arranca
#     (ArcaAmbienteValidator).
#   - Si la base ya esta marcada con otro ambiente, tampoco arranca
#     (RegistroDeAmbiente). Cada ambiente necesita SU base.
#   - Solo se monta la carpeta de certificados del ambiente en uso, asi que el
#     contenedor ni siquiera ve los del otro.
# =============================================================================

# --- HOMOLOGACION: comprobantes de prueba, sin validez fiscal ---------------
ARCA_AMBIENTE=HOMOLOGACION
ARCA_URL_WSAA=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_URL_WSFE=https://wswhomo.afip.gov.ar/wsfev1/service.asmx
ARCA_CERTS_ENTORNO=homologacion

# --- PRODUCCION: comprobantes fiscales REALES, no se pueden borrar ----------
#
# Antes de descomentar esto hay que tener:
#   1. Los certificados de produccion en arca/produccion/<cuit>/
#   2. El punto de venta habilitado en el portal de PRODUCCION de ARCA,
#      dado de alta como Web Services (no "Comprobantes en linea")
#   3. El servicio WSFE delegado al certificado desde el Administrador de
#      Relaciones de cada CUIT (en homologacion no hace falta; en produccion si)
#   4. Una base de datos vacia y distinta a la de homologacion
#   5. Los emisores cargados con seed/emisores.sql
#
# ARCA_AMBIENTE=PRODUCCION
# ARCA_URL_WSAA=https://wsaa.afip.gov.ar/ws/services/LoginCms
# ARCA_URL_WSFE=https://servicios1.afip.gov.ar/wsfev1/service.asmx
# ARCA_CERTS_ENTORNO=produccion
